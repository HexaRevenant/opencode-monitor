{
  "name": "@opencode-monitor/system-metrics-tui",
  "version": "0.1.0",
  "description": "OpenCode TUI sidebar plugin for live system metrics",
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "bun scripts/build.ts && tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "tsx --test test/format.test.ts",
    "typecheck": "tsc --noEmit",
    "install-font": "tsx scripts/install-hack-font.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@opentui/core": "^0.5.10",
    "@opentui/solid": "^0.5.10",
    "solid-js": "^1.9.12",
    "systeminformation": "^5.33.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.29",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
